**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Khóa ký số bản phát hành Android — TUYỆT ĐỐI KHÔNG commit ──────────────
# Mất khóa này là KHÔNG BAO GIỜ cập nhật được app cho người đã cài (phải gỡ
# rồi cài lại). Lộ khóa thì người khác có thể giả mạo bản cập nhật.
# Hãy sao lưu file .jks ở nơi an toàn (Drive riêng, trình quản lý mật khẩu).
/android/key.properties
**/*.jks
**/*.keystore

# Cấu hình Firebase (chứa khóa định danh dự án)
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
