<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Trí Long Land</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>kpi_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Khai báo tuân thủ xuất khẩu mã hoá. App chỉ dùng HTTPS tiêu chuẩn
	     (thuộc diện miễn trừ) nên đặt false. Thiếu khoá này, mỗi bản build
	     lên TestFlight sẽ bị kẹt ở trạng thái "Missing Compliance" và phải
	     trả lời thủ công trên App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Ứng dụng cần sử dụng Camera để chụp ảnh check-in thực địa, quét mã QR điểm danh và xác thực khuôn mặt</string>
	<!-- image_picker: BẮT BUỘC khi chọn ảnh từ Thư viện (ImageSource.gallery) — thiếu sẽ crash -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ứng dụng cần truy cập Thư viện ảnh để bạn chọn ảnh báo cáo thực chiến, bài đăng và đào tạo</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ứng dụng cần quyền lưu ảnh đã chụp vào Thư viện ảnh của bạn</string>
	<!-- camera plugin: iOS yêu cầu khai báo micro khi khởi tạo camera có ghi âm -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Ứng dụng cần micro khi quay video trong quá trình báo cáo thực chiến</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ứng dụng cần lấy vị trí của bạn để chấm công chính xác</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Ứng dụng cần lấy vị trí của bạn để chấm công chính xác</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Ứng dụng cần lấy vị trí của bạn để chấm công chính xác</string>
	<!-- url_launcher: khai báo scheme để kiểm tra và mở app ngoài (YouTube / Facebook) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>youtube</string>
		<string>vnd.youtube</string>
		<string>fb</string>
		<string>fbapi</string>
		<string>fb-messenger</string>
		<string>https</string>
		<string>http</string>
	</array>

	<!-- Thông báo đẩy: cho phép iOS đánh thức app để nhận thông báo nền -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
