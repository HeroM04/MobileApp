<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Trí Long Land</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>kpi_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Khai báo tuân thủ xuất khẩu mã hoá. App chỉ dùng HTTPS tiêu chuẩn
	     (thuộc diện miễn trừ) nên đặt false. Thiếu khoá này, mỗi bản build
	     lên TestFlight sẽ bị kẹt ở trạng thái "Missing Compliance" và phải
	     trả lời thủ công trên App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Ứng dụng dùng camera để chụp ảnh chân dung khi bạn chấm công (để xác nhận đúng người chấm công), chụp ảnh báo cáo gặp khách và quét mã QR điểm danh đào tạo.</string>
	<!-- image_picker: BẮT BUỘC khi chọn ảnh từ Thư viện (ImageSource.gallery) — thiếu sẽ crash -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ứng dụng cần truy cập Thư viện ảnh để bạn chọn ảnh có sẵn đính kèm báo cáo gặp khách, bài đăng, đào tạo và góp ý.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ứng dụng cần quyền lưu ảnh vào Thư viện ảnh khi bạn chọn lưu ảnh từ ứng dụng.</string>
	<!-- Thư viện camera tham chiếu tới micro nên iOS bắt khai báo; app chỉ chụp ảnh,
	     không quay video, không ghi âm nên không bao giờ hỏi quyền này. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Ứng dụng không ghi âm hay quay video. Quyền micro chỉ được khai báo kỹ thuật cho thư viện camera và không được sử dụng.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ứng dụng dùng vị trí khi bạn bấm chấm công hoặc gửi báo cáo gặp khách, để xác nhận bạn đang ở văn phòng hoặc tại điểm gặp khách. Ứng dụng không theo dõi vị trí khi chạy nền.</string>
	<!-- Hai khóa "Always" chỉ để qua kiểm tra tự động của Apple. Geolocator thấy có
	     khóa WhenInUse ở trên nên luôn xin quyền "Khi dùng ứng dụng", không xin "Luôn luôn". -->
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Ứng dụng chỉ dùng vị trí khi bạn bấm chấm công hoặc gửi báo cáo gặp khách. Ứng dụng không theo dõi vị trí khi chạy nền.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Ứng dụng chỉ dùng vị trí khi bạn bấm chấm công hoặc gửi báo cáo gặp khách. Ứng dụng không theo dõi vị trí khi chạy nền.</string>
	<!-- url_launcher: khai báo scheme để kiểm tra và mở app ngoài (YouTube / Facebook) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>youtube</string>
		<string>vnd.youtube</string>
		<string>fb</string>
		<string>fbapi</string>
		<string>fb-messenger</string>
		<string>https</string>
		<string>http</string>
	</array>

	<!-- Thông báo đẩy: cho phép iOS đánh thức app để nhận thông báo nền -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
